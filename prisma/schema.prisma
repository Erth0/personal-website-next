generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider     = "mysql"
    url          = env("DATABASE_URL")
    relationMode = "prisma"
}

model Subscribers {
    id         Int      @id @default(autoincrement())
    name       String?
    email      String   @unique
    created_at DateTime @default(now())
    updated_at DateTime @default(now())
}
